# VisibilityLab backend settings. No secrets live here.
# PowerShell: set for the current terminal with  $env:VL_PORT = "8000"
# (the API and the worker must see the same values).

# --- storage and network ---------------------------------------------------
# SQLite DB, raw evidence, quarantine, job results (never web-served)
VL_DATA_DIR=webapp/data
# loopback only; other addresses are refused...
VL_HOST=127.0.0.1
# ...unless this is true (put your own access control in front)
VL_ALLOW_REMOTE=false
VL_PORT=8000
VL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- upload limits (MB) ------------------------------------------------------
VL_MAX_JSON_MB=25
VL_MAX_CAPE_MB=150
VL_MAX_PE_MB=50
VL_MAX_BUNDLE_MB=60

# --- Gate 3 / safety switches (all off by default) ----------------------------
# Store PE files at all (quarantined, never executed, never served back):
VL_ALLOW_SAMPLE_UPLOAD=false
# Run capa on PE files. Enable ONLY on an isolated analysis VM with no network route:
VL_STATIC_ANALYSIS_ENABLED=false
# Must equal exactly I_CONFIRM_THIS_WORKER_RUNS_IN_AN_ISOLATED_ANALYSIS_VM for PE analysis:
VL_ISOLATION_ACK=

# --- capa (pinned) -----------------------------------------------------------
# Absolute path to the standalone capa executable; never looked up on PATH.
VL_CAPA_PATH=
# The worker refuses to run capa unless `capa --version` reports this version.
VL_CAPA_EXPECTED_VERSION=
# optional rules directory (standalone capa bundles its rules)
VL_CAPA_RULES=
VL_CAPA_TIMEOUT_S=600

# --- ATT&CK mapping for empirical runs ---------------------------------------
VL_ATTACK_MAPPING=mappings/attack_enterprise_v20.0.csv
VL_ATTACK_MAPPING_VERSION=ATT&CK Enterprise v20.0
